import ctypes

class DynArray:
    
    def __init__(self):
        self.count = 0
        self.capacity = 16
        self.array = self.make_array(self.capacity)
        self.coins = 0

    def __len__(self):
        return self.count

    def make_array(self, new_capacity):
        return (new_capacity * ctypes.py_object)()

    def __getitem__(self,i):
        if i < 0 or i >= self.count:
            raise IndexError('Index is out of bounds')
        return self.array[i]

    def resize(self, new_capacity):
        new_array = self.make_array(new_capacity)
        for i in range(self.count):
            new_array[i] = self.array[i]
            self.coins -= 1
        self.array = new_array
        self.capacity = new_capacity

    def append(self, itm):
        if self.count == self.capacity:
            self.resize(2*self.capacity)
        self.array[self.count] = itm
        self.count += 1
        self.coins += 2

    def insert(self, i, itm):
        if i < 0 or i > self.count:
            raise IndexError('Index is out of bounds')
        tmp_prev = self.array[i]
        if (self.count + 1) > self.capacity:
            self.resize(2*self.capacity)
        for index in range(i + 1, self.count + 1):
            if index == self.count:
                self.array[self.count] = tmp_prev
                self.count += 1
                #self.append(tmp_prev)
            else:
                tmp = self.array[index]
                self.array[index] = tmp_prev
                tmp_prev = tmp
        self.coins += 2        
        self.array[i] = itm

    def delete(self, i):
        if i < 0 or i >= self.count:
            raise IndexError('Index is out of bounds')
        tmp_next = self.array[self.count - 1]
        for index in range(self.count - 2, i - 1, -1):
            t1 = self.array[index]         
            self.array[index] = tmp_next
            tmp_next = t1
        if self.count <= self.capacity * 0.5 and self.capacity > 16:
            size = int(self.capacity / 1.5)
            if size > 16:
                self.resize(size)
            else:
                self.resize(16)
        self.coins += 1
        self.count -= 1



##########################################################

import ctypes

class DynArray:
    
    def __init__(self, level, size):
        self.count = 0
        self.size = size
        self.capacity = 16
        self.level = level
        if self.level > 1:
            self.array = self.make_array(self.capacity)
            for i in range(self.size[0]):
                 self.append(DynArray(self.level - 1, self.size[1:]))
        else:
            self.array = self.make_array(self.capacity)
            for i in range(self.size[0]):
                self.append(None)

    def __len__(self):
        return self.count

    def make_array(self, new_capacity):
        return (new_capacity * ctypes.py_object)()

    # def __getitem__(self,i):
    #     if len(i) != self.level:
    #         raise IndexError('Indexes is out of bounds')
    #     current = self
    #     for i in range(len(i) - 1):
    #         idx = indices[i]
    #         if idx < 0 or idx >= current.count:
    #             raise IndexError('Index is out of bounds')
    #         current = current.array[idx]


    def __getitem__ (self, indices):
        if len(indices) != self.level:
            raise IndexError('Invalid number of dimensions')

        current = self
        # Идём по позициям от 0 до предпоследней включительно
        for i in range(len(indices) - 1):
            idx = indices[i]
            if idx < 0 or idx >= current.count:
                raise IndexError('Index is out of bounds')
            current = current.array[idx]

        # Берём последний индекс
        last_idx = indices[len(indices) - 1]
        if last_idx < 0 or last_idx >= current.count:
            raise IndexError('Index is out of bounds')

        return current.array[last_idx]

    def resize(self, new_capacity):
        new_array = self.make_array(new_capacity)
        for i in range(self.count):
            new_array[i] = self.array[i]
        self.array = new_array
        self.capacity = new_capacity

    def append(self, itm):
        if self.count == self.capacity:
            self.resize(2*self.capacity)
        self.array[self.count] = itm
        self.count += 1

da = DynArray(3, [2,2,3])

print(da.__getitem__([1,1,1]))


